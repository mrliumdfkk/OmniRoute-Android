<?xml version="1.0" encoding="utf-8"?>
<!--
  Slow alpha pulse for the running indicator. Alpha only (never scale) so the
  dot keeps a constant footprint and does not nudge neighbouring icons.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1100"
    android:fromAlpha="0.25"
    android:repeatCount="infinite"
    android:repeatMode="reverse"
    android:toAlpha="1.0" />
