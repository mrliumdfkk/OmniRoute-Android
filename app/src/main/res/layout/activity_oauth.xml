<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/oauth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/oauth_config_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/oauth_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/oauth_back"
                android:padding="9dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/oauth_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- ===== 预设 ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/oauth_presets" />

                <TextView
                    style="@style/SettingsRowHint"
                    android:layout_marginBottom="6dp"
                    android:text="@string/oauth_presets_hint" />

                <!--
                    The provider buttons are generated at runtime from
                    OAuthConfig.DEVICE_CODE_PRESETS / AUTHORIZATION_CODE_PRESETS.
                    A fixed row of buttons used to be declared here and bound to
                    hard-coded preset indexes, which silently mismatched a
                    button with the wrong provider as soon as the list changed.
                    Building the rows from the same array the logic reads makes
                    that class of bug impossible.
                -->
                <LinearLayout
                    android:id="@+id/oauth_preset_container"
                    style="@style/Card"
                    android:orientation="vertical"
                    android:padding="8dp" />

                <TextView
                    style="@style/SettingsRowHint"
                    android:layout_marginTop="4dp"
                    android:text="@string/oauth_custom_hint" />

                <!-- ===== 授权配置 ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/oauth_section_config" />

                <LinearLayout
                    style="@style/Card"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:orientation="vertical"
                        android:paddingTop="0dp">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/oauth_authorize_url" />

                        <EditText
                            android:id="@+id/oauth_authorize_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:hint="https://..."
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/oauth_token_url" />

                        <EditText
                            android:id="@+id/oauth_token_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:hint="https://..."
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/oauth_client_id" />

                        <EditText
                            android:id="@+id/oauth_client_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/oauth_client_secret" />

                        <EditText
                            android:id="@+id/oauth_client_secret"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:fontFamily="monospace"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/oauth_scopes" />

                        <EditText
                            android:id="@+id/oauth_scopes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/oauth_redirect_uri" />

                        <TextView
                            style="@style/SettingsRowHint"
                            android:text="@string/oauth_redirect_hint" />

                        <EditText
                            android:id="@+id/oauth_redirect_uri"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:orientation="vertical"
                        android:paddingBottom="0dp">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/oauth_api_base" />

                        <EditText
                            android:id="@+id/oauth_api_base"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_input"
                            android:hint="https://..."
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== 选项 ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/oauth_section_options" />

                <LinearLayout
                    style="@style/Card"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingTop="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/oauth_pkce_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/oauth_pkce_hint" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/oauth_switch_pkce"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minWidth="48dp"
                            android:minHeight="32dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/oauth_external_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/oauth_external_hint" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/oauth_switch_external"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minWidth="48dp"
                            android:minHeight="32dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingBottom="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/oauth_save_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/oauth_save_hint" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/oauth_switch_save"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minWidth="48dp"
                            android:minHeight="32dp" />
                    </LinearLayout>
                </LinearLayout>

                <!--
                    Import-token panel.

                    Shown only for providers the runtime registers as
                    "import_token": their redirect URI points at the vendor's
                    own site, so the authorization code is never observable
                    locally and a browser flow cannot work. The user pastes a
                    token they already hold and the gateway normalises and
                    stores it.
                -->
                <LinearLayout
                    android:id="@+id/oauth_import_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/SettingsSection"
                        android:text="@string/oauth_import_title" />

                    <TextView
                        style="@style/SettingsRowHint"
                        android:layout_marginBottom="6dp"
                        android:text="@string/oauth_import_hint" />

                    <EditText
                        android:id="@+id/oauth_import_token"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="@string/oauth_import_placeholder"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:maxLines="6"
                        android:minLines="3"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/oauth_btn_import"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button"
                        android:text="@string/oauth_import_action"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/oauth_btn_authorize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button"
                    android:text="@string/oauth_start"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/oauth_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <WebView
        android:id="@+id/oauth_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
