<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/settings_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_back"
                android:padding="9dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- ===== 服务 ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_section_server" />

                <LinearLayout
                    style="@style/Card"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingTop="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_endpoint_title" />

                            <TextView
                                android:id="@+id/endpoint_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="@color/accent"
                                android:textSize="14sp"
                                android:textIsSelectable="true" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_endpoint_hint" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/settings_runtime_title" />

                        <TextView
                            android:id="@+id/runtime_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingTop="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_port_title" />

                            <TextView
                                android:id="@+id/port_hint"
                                style="@style/SettingsRowHint" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/port_input"
                            style="@style/SettingsInput"
                            android:layout_marginStart="12dp"
                            android:importantForAutofill="no"
                            android:selectAllOnFocus="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingBottom="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_listen_all_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_listen_all_hint" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switch_listen_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minWidth="48dp"
                            android:minHeight="32dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== 显示 ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_display" />

                <LinearLayout
                    style="@style/Card"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingTop="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_desktop_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_desktop_hint" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switch_desktop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minWidth="48dp"
                            android:minHeight="32dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_font_scale_title" />

                            <TextView
                                android:id="@+id/font_scale_hint"
                                style="@style/SettingsRowHint" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/font_scale_input"
                            style="@style/SettingsInput"
                            android:layout_marginStart="12dp"
                            android:importantForAutofill="no"
                            android:selectAllOnFocus="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingBottom="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_ball_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_ball_hint" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switch_ball"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minWidth="48dp"
                            android:minHeight="32dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingBottom="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_ball_size_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_ball_size_hint" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/ball_size_input"
                            style="@style/SettingsInput"
                            android:layout_marginStart="12dp"
                            android:inputType="number"
                            android:importantForAutofill="no"
                            android:selectAllOnFocus="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== 启动与保活 ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_startup" />

                <LinearLayout
                    style="@style/Card"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingTop="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_boot_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_boot_hint" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switch_boot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minWidth="48dp"
                            android:minHeight="32dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingBottom="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_crash_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_crash_hint" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switch_crash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minWidth="48dp"
                            android:minHeight="32dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:paddingBottom="0dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_watchdog_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_watchdog_hint" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switch_watchdog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:minWidth="48dp"
                            android:minHeight="32dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== 内存 ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_memory" />

                <LinearLayout
                    style="@style/Card"
                    android:orientation="vertical">

                    <LinearLayout style="@style/SettingsRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_heap_title" />

                            <TextView
                                android:id="@+id/heap_hint"
                                style="@style/SettingsRowHint" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/heap_input"
                            style="@style/SettingsInput"
                            android:layout_marginStart="12dp"
                            android:importantForAutofill="no"
                            android:selectAllOnFocus="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== 凭据 ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_credentials" />

                <LinearLayout
                    style="@style/Card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_client_keys"
                        style="@style/SettingsRow"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingTop="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/settings_client_keys_title"
                            android:src="@drawable/ic_key" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_client_keys_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_client_keys_hint" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/count_keys"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        android:id="@+id/row_providers"
                        style="@style/SettingsRow"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingBottom="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/settings_providers_title"
                            android:src="@drawable/ic_provider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_providers_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_providers_hint" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/count_providers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== OAuth ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_oauth" />

                <LinearLayout
                    style="@style/Card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_oauth"
                        style="@style/SettingsRow"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/settings_oauth_title"
                            android:src="@drawable/ic_oauth" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_oauth_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_oauth_hint" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== 运行时导入 ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_import" />

                <LinearLayout
                    style="@style/Card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_import"
                        style="@style/SettingsRow"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/settings_import_title"
                            android:src="@drawable/ic_import" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_import_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_import_hint" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== 工具 ===== -->
                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_tools" />

                <LinearLayout
                    style="@style/Card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_export"
                        style="@style/SettingsRow"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingTop="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/settings_export_title"
                            android:src="@drawable/ic_export" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_export_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_export_hint" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        android:id="@+id/row_battery"
                        style="@style/SettingsRow"
                        android:background="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/settings_battery_title"
                            android:src="@drawable/ic_battery" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_battery_title" />

                            <TextView
                                android:id="@+id/battery_hint"
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_battery_hint" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/battery_state"
                            style="@style/SettingsRowTitle"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        android:id="@+id/row_logs"
                        style="@style/SettingsRow"
                        android:background="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/settings_logs_title"
                            android:src="@drawable/ic_logs" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_logs_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_logs_hint" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        android:id="@+id/row_reset_password"
                        style="@style/SettingsRow"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingBottom="0dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/settings_reset_password_title"
                            android:src="@drawable/ic_key" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_reset_password_title" />

                            <TextView
                                style="@style/SettingsRowHint"
                                android:text="@string/settings_reset_password_hint" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 重启提示 -->
                <Button
                    android:id="@+id/btn_restart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_button"
                    android:text="@string/settings_restart_now"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
